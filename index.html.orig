<script>
/* The four ways, animated: plays each way's loop from video 21 on the stage, steps through them, shows the one tapped,
   and plays the answer on the concept bubble (Yes: it blooms gold; I kind of: it glows softly; No: the picture way, calmly).
   The same code runs the home page's test card. */
function tfWays(root) {
  var stage = root && root.querySelector('.fw-stage');
  if (!stage) return null;
  var media = stage.querySelector('.fw-media'), layers = [].slice.call(stage.querySelectorAll('.fw-layer'));
  var rows = [].slice.call(root.querySelectorAll('.fw-rows > li, .ways > li'));
  var dots = [].slice.call(stage.querySelectorAll('.fw-dots i')), toggle = stage.querySelector('.fw-toggle'), canvas = stage.querySelector('.fw-fx');
  var mq = window.matchMedia ? window.matchMedia('(prefers-reduced-motion: reduce)') : null;
  // Posters only with reduced motion, or when the browser asks to save data.
  var saveData = !!(navigator.connection && navigator.connection.saveData), still = saveData || !!(mq && mq.matches);
  var DWELL = [9, 9, 12];            // seconds on ways 1–3 before the stage steps on; it stays on the fourth
  var W0 = Math.PI / 4;              // the loops are 8 s
  var cur = 0, auto = true, paused = false, seen = false, near = false, spent = 0, last = 0, raf = 0;
  var said = null, saidAt = 0, fxA = 0, follow = true, reads = 0;
  root.classList.add('js');
  if (still) root.classList.add('still');

  function video(i) {
    var layer = layers[i], v = layer.querySelector('video');
    if (v || !layer.getAttribute('data-video')) return v;
    v = document.createElement('video');
    v.muted = true; v.defaultMuted = true; v.loop = true; v.playsInline = true; v.preload = 'auto';
    ['muted', 'playsinline', 'loop', 'disablepictureinpicture', 'disableremoteplayback'].forEach(function (a) { v.setAttribute(a, ''); });
    v.setAttribute('aria-hidden', 'true'); v.tabIndex = -1;
    v.addEventListener('playing', function () { layer.classList.add('is-playing'); });
    v.src = layer.getAttribute('data-video');
    layer.appendChild(v);
    return v;
  }
  function posters() {
    layers.forEach(function (l) { var img = l.querySelector('img[data-src]'); if (img) { img.src = img.getAttribute('data-src'); img.removeAttribute('data-src'); } });
  }
  // Play only the way on stage, only while it's on screen and the page is visible.
  function sync() {
    layers.forEach(function (l, i) {
      var v = l.querySelector('video'), want = !still && !paused && seen && i === cur && !document.hidden;
      if (want) {
        v = video(i);
        if (v && v.paused) { var p = v.play(); if (p && p.catch) p.catch(function () {}); }
      } else if (v && !v.paused) v.pause();
    });
    if (toggle) { toggle.hidden = still; toggle.setAttribute('aria-pressed', String(paused)); }
    wake();
  }
  function show(i, how) {
    if (i < 0 || i >= layers.length) return;
    if (how === 'user') { auto = false; paused = false; follow = false; }
    root.classList.toggle('slow', how === 'calm');
    media.classList.toggle('push', how === 'user' && !still);
    // Each way starts from its first frame (its poster).
    var v = i !== cur && layers[i].querySelector('video');
    if (v) { try { v.currentTime = 0; } catch (e) {} }
    cur = i; spent = 0;
    layers.forEach(function (l, k) { l.classList.toggle('is-on', k === i); });
    rows.forEach(function (r, k) {
      r.classList.toggle('is-on', k === i);
      var b = r.querySelector('.fw-pick'); if (b) { if (k === i) b.setAttribute('aria-current', 'step'); else b.removeAttribute('aria-current'); }
      var bar = r.querySelector('.fw-time'); if (bar) bar.style.transform = 'scaleX(0)';
    });
    media.setAttribute('aria-label', layers[i].getAttribute('data-alt') || '');
    dots.forEach(function (d, k) { d.classList.toggle('is-on', k === i); });
    if (near) posters();
    sync();
  }

  // ── The answer, drawn on the concept bubble the way ways.mjs draws it (video-21/web-quiz) ──
  var BLUE = { core: [238, 242, 255], hi: [227, 233, 255], lav: [185, 196, 255], mid: [159, 180, 255], deep: [95, 114, 216], glow: [142, 166, 255] };
  var GOLD = { core: [255, 246, 224], hi: [255, 233, 192], lav: [250, 214, 148], mid: [243, 203, 118], deep: [224, 154, 68], glow: [255, 190, 92] };
  function col(c, a) { return 'rgba(' + c[0] + ',' + c[1] + ',' + c[2] + ',' + Math.max(0, Math.min(1, a)).toFixed(3) + ')'; }
  function mixc(a, b, k) { return [0, 1, 2].map(function (j) { return Math.round(a[j] + (b[j] - a[j]) * k); }); }
  function clamp(u) { return u < 0 ? 0 : u > 1 ? 1 : u; }
  function smooth(u) { u = clamp(u); return u * u * (3 - 2 * u); }
  function out(u) { u = clamp(u); return 1 - Math.pow(1 - u, 3); }
  function hash(n) { var x = Math.sin(n * 127.1 + 311.7) * 43758.5453; return x - Math.floor(x); }
  function glow(g, x, y, r, c, a) {
    if (r <= 0 || a <= .002) return;
    var gr = g.createRadialGradient(x, y, 0, x, y, r); gr.addColorStop(0, col(c, a)); gr.addColorStop(1, col(c, 0));
    g.fillStyle = gr; g.fillRect(x - r, y - r, r * 2, r * 2);
  }
  function ring(g, x, y, r, c, a, w) { if (a <= .002) return; g.strokeStyle = col(c, a); g.lineWidth = w; g.beginPath(); g.arc(x, y, r, 0, Math.PI * 2); g.stroke(); }
  // Where the bubble is in way 4's loop at video time t (fractions of the stage's height; centred).
  function bubbleAt(t) {
    var z = 1.06 * (1 + .022 * Math.sin(W0 * t - .4)), bob = 7 * Math.sin(2 * W0 * t + .3);
    return { y: (540 + (bob - 44) * z) / 1080, r: 196 * z * (1 + .018 * Math.sin(2 * W0 * t + 1.9)) / 1080 };
  }
  function friend(g, x, y, R, t, gold, a, lum) {
    var H = {}, k, i, ph, rr;
    for (k in BLUE) H[k] = mixc(BLUE[k], GOLD[k], gold);
    g.globalCompositeOperation = 'lighter';
    glow(g, x, y, R * 3.3, H.glow, .1 * lum * a); glow(g, x, y, R * 1.9, H.glow, .18 * lum * a);
    g.globalCompositeOperation = 'source-over';
    var kk = Math.min(1.25, lum), cx = x - R * .1, cy = y - R * .12, gr = g.createRadialGradient(cx, cy, 0, cx, cy, R * 1.12);
    gr.addColorStop(0, col(H.core, .8 * kk * a)); gr.addColorStop(.3, col(H.hi, .68 * kk * a)); gr.addColorStop(.56, col(H.lav, .5 * kk * a));
    gr.addColorStop(.76, col(H.mid, .27 * kk * a)); gr.addColorStop(.9, col(H.deep, .08 * a)); gr.addColorStop(1, col(H.deep, 0));
    g.fillStyle = gr; g.fillRect(x - R * 1.25, y - R * 1.25, R * 2.5, R * 2.5);
    for (i = 0; i < 3; i++) { ph = (i === 1 ? -1 : 1) * (i > 1 ? 2 : 1) * W0 * t + i * 2.2; rr = R * (.2 + .13 * i); glow(g, x + Math.cos(ph) * rr, y + Math.sin(ph + i) * rr * .72, R * (.6 - .1 * i), i ? [255, 205, 176] : [255, 164, 140], (.36 - .06 * i) * a); }
    g.globalCompositeOperation = 'lighter';
    for (i = 0; i < 3; i++) { ph = (i % 2 ? 1 : -1) * (i + 1) * W0 * t + i * 1.7 + .6; rr = R * (.28 + .12 * i); glow(g, x + Math.cos(ph) * rr, y + Math.sin(ph + i) * rr * .8, R * (.42 - .05 * i), [242, 245, 255], .07 * lum * a); }
    glow(g, x - R * .08, y - R * .1, R * .45, [255, 255, 255], .1 * lum * a);
    for (i = 0; i < 8; i++) {
      var h1 = hash(273.1 + i * 7.7), h2 = hash(111.3 + i * 3.1), an = h1 * Math.PI * 2 + (i % 2 ? 1 : -1) * (1 + i % 3) * W0 * t, d = R * (.15 + .6 * h2);
      g.fillStyle = col([255, 255, 255], .5 * a * (.5 + .5 * Math.sin((2 + i % 4) * W0 * t + i)));
      g.beginPath(); g.arc(x + Math.cos(an) * d, y + Math.sin(an) * d * .8, Math.max(.8, R * .018), 0, Math.PI * 2); g.fill();
    }
    // Motes of its light circling it.
    for (i = 0; i < 5; i++) { ph = W0 * t + i * Math.PI * 2 / 5 + .4; var mx = x + Math.cos(ph) * R * 1.45, my = y + Math.sin(ph) * R * .95, mr = Math.max(1, R * .03); glow(g, mx, my, mr * 4, H.glow, .3 * a); glow(g, mx, my, mr * 1.6, [255, 246, 228], .6 * a); }
    g.globalCompositeOperation = 'source-over';
  }
  function fx(now) {
    if (!canvas) return false;
    var w = stage.clientWidth, h = stage.clientHeight, d = Math.min(window.devicePixelRatio || 1, 2);
    if (canvas.width !== Math.round(w * d) || canvas.height !== Math.round(h * d)) { canvas.width = Math.round(w * d); canvas.height = Math.round(h * d); }
    var g = canvas.getContext('2d'); g.setTransform(1, 0, 0, 1, 0, 0); g.clearRect(0, 0, canvas.width, canvas.height);
    var on = (said === 'yes' || said === 'kindof') && cur === 3;
    fxA = still ? (on ? 1 : 0) : Math.max(0, Math.min(1, fxA + (on ? .06 : -.08)));
    if (fxA <= 0) return on;
    var v = layers[3].querySelector('video'), t = v && !still ? v.currentTime || 0 : 0, b = bubbleAt(t);
    var x = canvas.width / 2, y = b.y * canvas.height, R = b.r * canvas.height;
    var u = still ? 9 : (now - saidAt) / 1000, breath = 1 + .05 * Math.sin(u * Math.PI / 2);
    g.globalAlpha = fxA;
    if (said === 'yes') {
      // It blooms gold: a flash, two rings leaving it, sparks flying out, and the gold stays.
      var f = u < .14 ? u / .14 : Math.max(0, 1 - (u - .14) / .9);
      friend(g, x, y, R * (1 + .06 * out(u / .6)), t, smooth(u / 1.1), smooth(u / .45), (1.1 + .25 * f) * breath);
      g.globalCompositeOperation = 'lighter';
      glow(g, x, y, R * (2 + 2.5 * (1 - f)), [255, 244, 220], .5 * f); glow(g, x, y, R * 1.2, [255, 255, 255], .4 * f);
      glow(g, x, y, R * 3.2, [255, 196, 110], .09 * smooth(u / 1.4));
      for (var j = 0; j < 2; j++) { var k = out((u - j * .3) / 1.6); if (k > 0 && k < 1) { ring(g, x, y, R * (1.06 + 1.5 * k), [255, 232, 176], .5 * (1 - k), Math.max(1.2, R * .03)); ring(g, x, y, R * (1.06 + 1.5 * k), [255, 190, 92], .16 * (1 - k), Math.max(3, R * .16)); } }
      for (var i = 0; i < 18; i++) {
        var hh = hash(i * 3.1), h2 = hash(i * 7.7 + 1), an = i / 18 * Math.PI * 2 + hh * .5, dd = R * (1.02 + (.7 + 1.1 * h2) * out((u - .05) / 2.2)), sa = smooth(u / .2) * (1 - smooth((u - .4) / 2.2));
        var px = x + Math.cos(an) * dd, py = y + Math.sin(an) * dd * .9 - R * .3 * smooth(u / 2.6);
        glow(g, px, py, R * .08, [255, 200, 110], .45 * sa); glow(g, px, py, R * .028, [255, 248, 230], .95 * sa);
      }
    } else if (said === 'kindof') {
      // It glows softly: warmer light comes up in it, a slow ring, and it stays a little brighter.
      var s = smooth(u / 1.8);
      friend(g, x, y, R * (1 + .03 * s), t, .5 * s, .8 * smooth(u / 1.2), (1 + .38 * s) * breath);
      g.globalCompositeOperation = 'lighter';
      glow(g, x, y, R * 2.6, [255, 214, 170], .12 * s * breath);
      var kr = out(u / 2.6); if (kr < 1) ring(g, x, y, R * (1.05 + 1.1 * kr), [255, 226, 196], .22 * (1 - kr), Math.max(2, R * .1));
    }
    g.globalCompositeOperation = 'source-over'; g.globalAlpha = 1;
    return on;
  }

  // One clock for the steps, their progress lines and the answer's light.
  function frame(now) {
    raf = 0;
    var dt = last ? Math.min(.1, (now - last) / 1000) : 0; last = now;
    var running = !still && !paused && seen && !document.hidden;
    if (auto && running && cur < 3) {
      spent += dt;
      // A few seconds into a way, the next one starts loading.
      if (spent > 3 && !layers[cur + 1].querySelector('video')) video(cur + 1);
      var bar = rows[cur] && rows[cur].querySelector('.fw-time');
      if (bar) bar.style.transform = 'scaleX(' + Math.min(1, spent / DWELL[cur]).toFixed(4) + ')';
      if (spent >= DWELL[cur]) show(cur + 1, 'auto');
    }
    var lit = fx(now);
    if ((auto && running && cur < 3) || (lit && running) || fxA > 0 && !still && (fxA < 1 || running)) raf = requestAnimationFrame(frame);
    else last = 0;
  }
  function wake() { if (!raf) { last = 0; raf = requestAnimationFrame(frame); } }

  rows.forEach(function (row, i) {
    row.addEventListener('click', function (e) { if (e.target.closest('a')) return; show(i, 'user'); });
  });
  // Where the stage sits above the list (phones, the home card), it stays at the top of the screen while the list scrolls
  // under it. Until a way is tapped, it follows the reader: the way just below it is the one on the stage.
  function reading() {
    reads = 0;
    if (!follow || said || !rows.length) return;
    var wrap = stage.parentNode, wb = wrap.getBoundingClientRect(), r0 = rows[0].getBoundingClientRect();
    if (r0.left >= wb.right - 1) return;
    if (Math.abs(wb.top - (parseFloat(getComputedStyle(wrap).top) || 0)) > 1.5) return;
    var line = wb.bottom + .12 * (window.innerHeight - wb.bottom), pick = -1;
    rows.forEach(function (r, i) { if (r.getBoundingClientRect().top < line) pick = i; });
    if (pick >= 0 && pick !== cur) show(pick, 'scroll');
  }
  window.addEventListener('scroll', function () { if (!reads) reads = requestAnimationFrame(reading); }, { passive: true });
  if (toggle) toggle.addEventListener('click', function () { paused = !paused; sync(); });
  // Swipe the stage to step through the ways.
  var x0 = null;
  stage.addEventListener('pointerdown', function (e) { x0 = e.clientX; });
  stage.addEventListener('pointerup', function (e) {
    if (x0 === null) return; var dx = e.clientX - x0; x0 = null;
    if (Math.abs(dx) > 40) show(Math.max(0, Math.min(layers.length - 1, cur + (dx < 0 ? 1 : -1))), 'user');
  });
  stage.addEventListener('pointercancel', function () { x0 = null; });

  if ('IntersectionObserver' in window) {
    new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) root.classList.add('is-in'); }); }, { threshold: .08 }).observe(root);
    new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting && !near) { near = true; posters(); sync(); } }); }, { rootMargin: '600px 0px' }).observe(stage);
    new IntersectionObserver(function (es) { es.forEach(function (e) { seen = e.intersectionRatio >= .35; sync(); }); }, { threshold: [0, .35, .7] }).observe(stage);
  } else { root.classList.add('is-in'); near = seen = true; posters(); }
  document.addEventListener('visibilitychange', sync);
  window.addEventListener('resize', function () { if (said) wake(); });
  if (mq) {
    var change = function () { still = saveData || mq.matches; root.classList.toggle('still', still); sync(); fx(performance.now()); };
    if (mq.addEventListener) mq.addEventListener('change', change); else if (mq.addListener) mq.addListener(change);
  }
  sync();

  return {
    // The answer plays on the stage: Yes, the bubble blooms gold; I kind of, it glows softly; No, the stage calmly shows the
    // picture way. null clears it.
    answer: function (kind) {
      said = kind; saidAt = performance.now(); auto = false; paused = false;
      root.classList.toggle('answered', !!kind);
      if (kind === 'no') setTimeout(function () { if (said === 'no') show(0, 'calm'); }, still || cur !== 3 ? 0 : 900);
      else if (kind) show(3, 'answer');
      else { root.classList.remove('slow'); fxA = 0; }
      sync(); wake(); if (still) fx(performance.now());
    }
  };
}
</script>
<script>
(function () {
  var tfTrack = window.tfTrack || function () {};
  /* ---------- The test: the four ways to think about your best friend; can you do the fourth? ---------- */
  // Since 2026-10-27 the test is the question from the live lessons (it replaced the four-step "surprise party"
  // test, and the quiz at /quiz/ asks the same). The answer goes along with an email signup (as test_result and
  // test_answers), so each signup says whether the person has thoughtfeel.
  var imtSummary = '', imtOutcome = '';
  var imt = document.getElementById('imt');
  if (imt) (function () {
    var ask = document.getElementById('imt-ask'), out = document.getElementById('imt-result');
    // The four ways' stage (tfWays, above): it plays each way, then the answer on the concept bubble.
    var ways = window.tfWays ? tfWays(imt) : null;
    // Tagged so GoatCounter shows visits that came from a shared test.
    var SHARE_URL = 'https://thoughtfeel.net/quiz/?ref=test-share';
    var SAID = { yes: 'Yes', kindof: 'I kind of get what you mean', no: 'What are you talking about?' };
    var RESULTS = {
      yes: ['You can use concept bubbles.', 'The fourth way is unsymbolized thinking: a thought with no words and no picture. The concept bubbles technique is built on it. People who can do it use it to learn complex material and keep it.'],
      kindof: ['You can almost certainly use concept bubbles.', 'If you can get a sense of what the words are asking you to do, you can do it. The question is unusual, so a hedge is normal: people who answer “I kind of get what you mean” have turned out to be able to do it.'],
      no: ['Concept bubbles probably won’t work for you.', 'If the fourth way sounds like nothing, or you can’t tell what it’s asking you to do, that’s the sign. Most people think in pictures, words or both, and that’s fine.']
    };
    var OUTCOME = { yes: 'strong', kindof: 'kindof', no: 'none' };

    function show(answer) {
      var r = RESULTS[answer], has = answer !== 'no';
      imtOutcome = OUTCOME[answer];
      imtSummary = 'can do the fourth way: ' + SAID[answer];
      ask.hidden = true;
      out.innerHTML =
        '<p class="imt-label">Your answer: ' + SAID[answer] + '</p>' +
        '<p class="imt-head" tabindex="-1">' + r[0] + '</p>' +
        '<p class="imt-text">' + r[1] + '</p>' +
        '<div class="imt-actions">' +
          (has
            ? '<a class="btn primary" href="#start" data-act="to-lessons">Start with the lesson</a>'
            : '<a class="btn primary" href="/concept-bubbles/" data-act="to-definition">Read what concept bubbles are</a>') +
          '<button type="button" class="btn" data-act="share">Ask a friend</button>' +
        '</div>' +
        '<p class="imt-text"><a class="linkish" href="#updates" data-act="join">Get new lessons by email</a> · <button type="button" class="linkish" data-act="again">Change your answer</button></p>';
      out.hidden = false;
      var head = out.querySelector('.imt-head'); if (head) head.focus({ preventScroll: true });
      tfTrack('test-answer-' + answer);
      if (ways) ways.answer(answer);
    }

    function share(button) {
      var text = 'Think about your best friend. There are four ways people do it. Can you do the fourth one?';
      var done = function () { button.textContent = 'Link copied'; setTimeout(function () { button.textContent = 'Ask a friend'; }, 1800); };
      if (navigator.share) { navigator.share({ title: 'Can you use concept bubbles?', text: text, url: SHARE_URL }).catch(function () {}); return; }
      var fallback = function () {
        var ta = document.createElement('textarea'); ta.value = text + ' ' + SHARE_URL;
        ta.setAttribute('readonly', ''); ta.style.position = 'absolute'; ta.style.left = '-9999px';
        document.body.appendChild(ta); ta.select();
        try { document.execCommand('copy'); done(); } catch (e) {}
        document.body.removeChild(ta);
      };
      if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(text + ' ' + SHARE_URL).then(done, fallback);
      else fallback();
    }

    imt.addEventListener('click', function (e) {
      var b = e.target.closest('button, a[data-act]');
      if (!b) return;
      var answer = b.getAttribute('data-answer');
      if (answer) { show(answer); return; }
      var act = b.getAttribute('data-act');
      if (act === 'again') {
        out.hidden = true; out.innerHTML = ''; ask.hidden = false; imtOutcome = ''; imtSummary = '';
        if (ways) ways.answer(null);
        var first = ask.querySelector('button'); if (first) first.focus({ preventScroll: true });
      }
      else if (act === 'share') { share(b); tfTrack('test-share'); }
      else if (act === 'to-lessons' || act === 'to-app' || act === 'to-definition') tfTrack('test-' + act);
      else if (act === 'join') {
        // Pre-answer the signup's "do you recognize it?" question from the answer, unless it's already answered.
        var form = document.getElementById('signup');
        if (form && !form.querySelector('input[name="recognizes_thoughtfeel"]:checked')) {
          var id = { strong: 'signup-yes', kindof: 'signup-yes', none: 'signup-no' }[imtOutcome];
          var radio = id && document.getElementById(id);
          if (radio) radio.checked = true;
        }
      }
    });
  })();

  /* ---------- Testimonials: arrows that scroll the row of cards, shown only when it overflows ---------- */
  (function () {
    var track = document.querySelector('.voices-track'), nav = document.querySelector('.voices-nav');
    if (!track || !nav) return;
    var arrows = nav.querySelectorAll('.voices-arrow');
    function update() {
      var over = track.scrollWidth > track.clientWidth + 4;
      nav.hidden = !over;
      arrows[0].disabled = track.scrollLeft <= 4;
      arrows[1].disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
    }
    nav.addEventListener('click', function (e) {
      var b = e.target.closest('.voices-arrow'); if (!b) return;
      var card = track.querySelector('.voice');
      var step = card ? card.getBoundingClientRect().width + 16 : track.clientWidth * 0.9;
      track.scrollBy({ left: step * Number(b.getAttribute('data-dir')), behavior: 'smooth' });
    });
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    if (window.ResizeObserver) new ResizeObserver(update).observe(track);
    // An opened card widens; bring the whole card into view and count it.
    track.addEventListener('toggle', function (e) {
      var d = e.target; if (!d.classList || !d.classList.contains('voice-more')) return;
      setTimeout(update, 300);
      if (d.open) {
        var card = d.closest('.voice');
        setTimeout(function () { card.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'nearest' }); }, 280);
        var who = ((card.querySelector('.voice-name') || {}).textContent || '').trim();
        tfTrack('testimonial-open-' + (who.toLowerCase().replace(/[^a-z0-9]+/g, '-') || 'card'), who);
      }
    }, true);
    update();
  })();

  /* ---------- The video to start with: play it in place, in YouTube's privacy-enhanced player ---------- */
  (function () {
    var link = document.querySelector('.start-player');
    if (!link) return;
    link.addEventListener('click', function (e) {
      // A middle click or a modifier key still opens it on YouTube.
      if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      e.preventDefault();
      var frame = document.createElement('iframe');
      frame.className = 'start-frame';
      frame.src = 'https://www.youtube-nocookie.com/embed/' + /[?&]v=([\w-]+)/.exec(link.getAttribute('href'))[1] + '?autoplay=1&rel=0&playsinline=1';
      frame.title = document.getElementById('start-title').textContent;
      frame.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      frame.allowFullscreen = true;
      link.replaceWith(frame);
      frame.focus();
    });
  })();

  /* ---------- Which lessons people open, and who goes on to the full quiz ---------- */
  document.addEventListener('click', function (e) {
    var a = e.target.closest('a');
    if (!a) return;
    var v = /[?&]v=([\w-]+)/.exec(a.getAttribute('href') || '');
    if (a.classList.contains('start-app')) {
      tfTrack('start-to-app', 'Start here: the whole lesson at stories.thoughtfeel.net');
    } else if (a.classList.contains('start-player')) {
      tfTrack('start-video', 'Start here: the interactive lesson');
    } else if (v) {
      var card = a.closest('.video');
      var label = card ? (card.querySelector('.video-label') || {}).textContent : '';
      var num = /Video (\d+)/.exec(label || a.textContent || '');
      tfTrack('lesson-' + (num ? num[1] : v[1]), (label || a.textContent || '').trim());
    } else if ((a.getAttribute('href') || '').indexOf('/quiz/') === 0) {
      // Since 2026-10-10 these go to quiz v2, counted under their own names.
      var dest = (a.getAttribute('href') || '').indexOf('/quiz/v2/') === 0 ? 'quiz2' : 'quiz';
      tfTrack((a.closest('#test') ? 'test-to-' : 'home-to-') + dest);
    } else if ((a.getAttribute('href') || '').indexOf('/words/') === 0) {
      tfTrack('home-to-words');
    } else if ((a.getAttribute('href') || '').indexOf('/texts/') === 0) {
      tfTrack('home-to-texts');
    } else if ((a.getAttribute('href') || '').indexOf('thoughtfeel.substack.com') !== -1) {
      tfTrack(a.closest('.byline') ? 'byline-to-substack' : a.closest('.read-first') ? 'read-start-here' : 'home-to-substack');
    } else if (a.closest('.voice')) {
      // A link in a testimonial (where to find that person), counted per person.
      var who = ((a.closest('.voice').querySelector('.voice-name') || {}).textContent || '').trim();
      tfTrack('testimonial-' + (who.toLowerCase().replace(/[^a-z0-9]+/g, '-') || 'link'), who);
    }
  });

  /* ---------- Email signup (tfSignup, from build.mjs, sends it to the email list) ---------- */
  // Looked up when it's used, since build.mjs defines it in the page head.
  function tfSignup(d) { return window.tfSignup ? window.tfSignup(d) : Promise.reject(new Error('no signup')); }
  var signup = document.getElementById('signup');
  if (signup) signup.addEventListener('submit', function (e) {
    e.preventDefault();
    var status = document.getElementById('signup-status');
    var button = document.getElementById('signup-submit');
    var emailEl = document.getElementById('signup-email');
    var email = emailEl.value.trim();
    var setStatus = function (text, cls) { status.textContent = text; status.className = 'signup-status' + (cls ? ' ' + cls : ''); };
    if (!emailEl.checkValidity() || !email) { setStatus('Enter an email address like you@example.com.', 'miss'); emailEl.focus(); return; }
    var picked = signup.querySelector('input[name="recognizes_thoughtfeel"]:checked');
    var waitlist = document.getElementById('signup-waitlist').checked;
    var done = waitlist ? 'Thanks! You’re on the list, and on the waitlist for guided training.' : 'Thanks! You’re on the list.';
    if (signup.elements._honey.value) { setStatus(done, 'ok'); return; }
    button.disabled = true;
    setStatus('Signing you up…');
    tfSignup({
      email: email,
      list: waitlist ? 'waitlist' : 'lessons',
      subject: waitlist ? 'New thoughtfeel waitlist signup (home)' : 'New thoughtfeel signup',
      fields: {
        signup_source: 'home',
        recognizes_thoughtfeel: picked ? picked.value : '',
        test_result: imtOutcome,
        test_answers: imtSummary
      }
    })
      .then(function () {
        setStatus(done, 'ok');
        signup.reset();
        tfTrack('signup-home');
        if (waitlist) tfTrack('waitlist-home');
      })
      .catch(function (err) {
        if (!(window.tfSignupFailed && window.tfSignupFailed(status, err))) setStatus('That didn’t go through. Email teddyshachtman@gmail.com to sign up instead.', 'miss');
      })
      .then(function () { button.disabled = false; });
  });

  /* ---------- Copy email ---------- */
  var copyEmail = document.getElementById('copy-email');
  if (copyEmail) copyEmail.addEventListener('click', function () {
    var el = document.getElementById('email-address');
    var select = function () {
      var r = document.createRange(); r.selectNodeContents(el);
      var sel = window.getSelection(); sel.removeAllRanges(); sel.addRange(r);
      copyEmail.textContent = 'Selected, press copy';
    };
    try {
      navigator.clipboard.writeText(el.textContent.trim()).then(function () {
        copyEmail.textContent = 'Copied';
        setTimeout(function () { copyEmail.textContent = 'Copy address'; }, 1800);
      }, select);
    } catch (e) { select(); }
  });
})();
</script>
<script>
/* The hero's two stories (2026-11-10). Both sentences are read at once, one part at a time. On the left each part
   brings its picture (the well story, from video 19). On the right each part brings a concept bubble: a light with no
   shape, joined to the one before it by a thread. Then both hold, and it starts again. A visit opens on the finished
   state for a couple of seconds, so the whole idea is there at first glance. It runs only while it's on screen, and with prefers-reduced-motion it shows the finished state and stays still. */
(function () {
  var duo = document.getElementById('duo');
  if (!duo) return;
  var tfTrack = window.tfTrack || function () {};
  var shots = [].slice.call(duo.querySelectorAll('.duo-shot'));
  var lines = [].slice.call(duo.querySelectorAll('.duo-line')).map(function (p) { return [].slice.call(p.querySelectorAll('span')); });
  var empty = duo.querySelector('.duo-empty'), canvas = duo.querySelector('.duo-sky');
  var g = canvas && canvas.getContext ? canvas.getContext('2d') : null;
  var mq = window.matchMedia ? window.matchMedia('(prefers-reduced-motion: reduce)') : null;
  var still = !!(mq && mq.matches);
  var READ = [0.5, 3.0, 5.5], HOLD = 10.8, END = 12;   // seconds: when each part is read, when the hold ends, the loop
  var clock = HOLD - 2.6, last = 0, raf = 0, seen = false, part = -9;

  function clamp(u) { return u < 0 ? 0 : u > 1 ? 1 : u; }
  function smooth(u) { u = clamp(u); return u * u * (3 - 2 * u); }
  function back(u) { u = clamp(u); var c = 1.9; return 1 + (c + 1) * Math.pow(u - 1, 3) + c * Math.pow(u - 1, 2); }
  function hash(n) { var x = Math.sin(n * 127.1 + 311.7) * 43758.5453; return x - Math.floor(x); }
  function col(c, a) { return 'rgba(' + c[0] + ',' + c[1] + ',' + c[2] + ',' + clamp(a).toFixed(3) + ')'; }

  // Which part is being read: -1 before the first, 0–2, then 3 once all three are said.
  function setPart(n) {
    if (n === part) return;
    part = n;
    shots.forEach(function (s, i) { s.classList.toggle('is-on', n >= 0 && i === Math.min(n, 2)); });
    if (empty) empty.style.opacity = n < 0 ? 1 : 0;
    lines.forEach(function (spans) {
      spans.forEach(function (s, i) { s.classList.toggle('is-said', i <= n); s.classList.toggle('is-now', i === n); });
    });
  }

  // ── The night sky and its bubbles ──
  var GOLD = { core: [255, 248, 226], mid: [255, 214, 132], edge: [242, 160, 62], deep: [217, 116, 30], halo: [255, 180, 80] };
  var BLUE = { core: [240, 243, 255], mid: [186, 200, 255], edge: [134, 152, 244], deep: [88, 104, 216], halo: [140, 160, 255] };
  var SPOTS = [[.2, .5, GOLD], [.5, .33, BLUE], [.8, .5, GOLD]];
  function glow(x, y, r, c, a) {
    if (a <= .003 || r <= .3) return;
    var gr = g.createRadialGradient(x, y, 0, x, y, r);
    gr.addColorStop(0, col(c, a)); gr.addColorStop(.2, col(c, a * .6)); gr.addColorStop(.5, col(c, a * .2)); gr.addColorStop(1, col(c, 0));
    g.fillStyle = gr; g.fillRect(x - r, y - r, r * 2, r * 2);
  }
  function bubble(x, y, r, t, C, seed, a) {
    if (r < .8 || a <= .01) return;
    r *= 1 + .035 * Math.sin(t * 1.7 + seed * 2.1);
    g.globalCompositeOperation = 'lighter';
    glow(x, y, r * 4.6, C.halo, .17 * a); glow(x, y, r * 2.4, C.halo, .42 * a);
    g.globalCompositeOperation = 'source-over';
    var gr = g.createRadialGradient(x - r * .16, y - r * .2, 0, x, y, r * 1.06);
    gr.addColorStop(0, col(C.core, a)); gr.addColorStop(.3, col(C.mid, a)); gr.addColorStop(.68, col(C.edge, a));
    gr.addColorStop(.88, col(C.deep, .9 * a)); gr.addColorStop(.96, col(C.deep, .45 * a)); gr.addColorStop(1, col(C.deep, 0));
    g.fillStyle = gr; g.fillRect(x - r * 1.1, y - r * 1.1, r * 2.2, r * 2.2);
    // the inner texture: slow wisps of light turning over one another
    g.save(); g.beginPath(); g.arc(x, y, r * .94, 0, Math.PI * 2); g.clip(); g.globalCompositeOperation = 'lighter';
    for (var k = 0; k < 6; k++) {
      var h = hash(seed * 7.3 + k), h2 = hash(seed * 3.1 + k * 1.7), sp = (.28 + .4 * h) * (k % 2 ? 1 : -1), an = t * sp + h2 * 6.283, q = r * (.16 + .42 * h2);
      g.save(); g.translate(x + Math.cos(an) * q, y + Math.sin(an * 1.13 + k) * q); g.rotate(an * 1.2 + k); g.scale(1, .36 + .2 * h);
      var w = g.createRadialGradient(0, 0, 0, 0, 0, r * .7); w.addColorStop(0, col(C.core, .2 * a)); w.addColorStop(.5, col(C.core, .07 * a)); w.addColorStop(1, col(C.core, 0));
      g.fillStyle = w; g.fillRect(-r, -r, 2 * r, 2 * r); g.restore();
    }
    var hr = g.createRadialGradient(x - r * .1, y - r * .14, 0, x - r * .1, y - r * .14, r * .7);
    hr.addColorStop(0, col([255, 255, 255], .5 * a)); hr.addColorStop(.4, col([255, 255, 255], .16 * a)); hr.addColorStop(1, col([255, 255, 255], 0));
    g.fillStyle = hr; g.fillRect(x - r, y - r, 2 * r, 2 * r);
    g.restore();
    // a few sparks circling it
    g.globalCompositeOperation = 'lighter';
    for (var i = 0; i < 5; i++) {
      var s1 = hash(seed * 11.1 + i * 3.3), sa = t * (.5 + .4 * s1) * (i % 2 ? 1 : -1) + s1 * 6.283, sq = r * (1.25 + .4 * hash(seed + i)), tw = .5 + .5 * Math.sin(t * (2 + 3 * s1) + i);
      var sx = x + Math.cos(sa) * sq, sy = y + Math.sin(sa) * sq * .9, sr = Math.max(.8, r * .024);
      glow(sx, sy, sr * 7, C.core, .3 * tw * a); glow(sx, sy, sr * 2, [255, 255, 255], .8 * tw * a);
    }
    g.globalCompositeOperation = 'source-over';
  }
  function thread(a, b, grow, t, alpha, W) {
    if (grow <= 0 || alpha <= .01) return;
    var d = Math.hypot(b[0] - a[0], b[1] - a[1]), cx = (a[0] + b[0]) / 2, cy = (a[1] + b[1]) / 2 + d * .1 + Math.sin(t * .9 + a[0]) * d * .012, N = 28, P = [], i;
    for (i = 0; i <= N; i++) { var u = i / N * clamp(grow), v = 1 - u; P.push([v * v * a[0] + 2 * v * u * cx + u * u * b[0], v * v * a[1] + 2 * v * u * cy + u * u * b[1]]); }
    var path = function () { g.beginPath(); P.forEach(function (p, j) { if (j) g.lineTo(p[0], p[1]); else g.moveTo(p[0], p[1]); }); };
    var w = Math.max(1.4, W * .0034);
    g.save(); g.globalCompositeOperation = 'lighter'; g.lineCap = 'round'; g.lineJoin = 'round';
    path(); g.strokeStyle = col([255, 168, 80], .1 * alpha); g.lineWidth = w * 9; g.stroke();
    path(); g.strokeStyle = col([255, 201, 120], .28 * alpha); g.lineWidth = w * 3.4; g.stroke();
    path(); g.strokeStyle = col([255, 243, 214], .92 * alpha); g.lineWidth = w; g.stroke();
    g.restore();
    g.globalCompositeOperation = 'lighter';
    var tip = P[N], pu, pv;
    if (grow < 1) { glow(tip[0], tip[1], w * 12, [255, 224, 160], .6 * alpha); glow(tip[0], tip[1], w * 4, [255, 255, 255], .9 * alpha); }
    else { pu = (t * .34 + hash(a[0])) % 1; pv = 1 - pu; var px = pv * pv * a[0] + 2 * pv * pu * cx + pu * pu * b[0], py = pv * pv * a[1] + 2 * pv * pu * cy + pu * pu * b[1], pa = Math.sin(Math.PI * pu) * alpha; glow(px, py, w * 10, [255, 224, 160], .5 * pa); glow(px, py, w * 3, [255, 255, 255], .8 * pa); }
    g.globalCompositeOperation = 'source-over';
  }
  function sky(t, c) {
    if (!g) return;
    var box = canvas.parentNode.getBoundingClientRect(), d = Math.min(window.devicePixelRatio || 1, 2), W = Math.round(box.width * d), H = Math.round(box.height * d);
    if (!W || !H) return;
    if (canvas.width !== W || canvas.height !== H) { canvas.width = W; canvas.height = H; }
    g.setTransform(1, 0, 0, 1, 0, 0); g.globalAlpha = 1; g.globalCompositeOperation = 'source-over';
    var hz = H * .8, bg = g.createLinearGradient(0, 0, 0, H);
    bg.addColorStop(0, '#0c0828'); bg.addColorStop(.42, '#1d1048'); bg.addColorStop(.68, '#43186a'); bg.addColorStop(.8, '#8a2e78'); bg.addColorStop(.805, '#1c0f40'); bg.addColorStop(1, '#0c0722');
    g.fillStyle = bg; g.fillRect(0, 0, W, H);
    g.globalCompositeOperation = 'lighter';
    glow(W * .5, hz, W * .62, [226, 96, 138], .3); glow(W * .5, hz, W * .22, [255, 170, 150], .22);
    for (var i = 0; i < 46; i++) {
      var sx = hash(i * 1.7) * W, sy = Math.pow(hash(i * 3.1 + .4), 1.4) * hz * .86, tw = .45 + .55 * Math.sin(t * (.7 + 2 * hash(i * 5.3)) + i);
      g.fillStyle = col([238, 232, 255], .75 * tw * (1 - sy / hz)); g.beginPath(); g.arc(sx, sy, Math.max(.6, W * .0012) * (.6 + hash(i * 9.1)), 0, Math.PI * 2); g.fill();
    }
    g.globalCompositeOperation = 'source-over';
    var fade = 1 - smooth((c - HOLD) / (END - HOLD - .15)), R = Math.min(W * .074, H * .17), at = [], k;
    for (k = 0; k < 3; k++) {
      var a = c - READ[k], S = SPOTS[k], x = S[0] * W + Math.sin(t * .8 + k * 2) * W * .004, y = S[1] * H + Math.sin(t * .66 + k * 1.3) * H * .012;
      if (a < 0) { at.push(null); continue; }
      // a point of light comes down from the words, then swells into the bubble
      var fall = smooth(a / .75), swell = a < .55 ? 0 : back((a - .55) / 1.05), by = -H * .06 + (y + H * .06) * fall;
      at.push({ x: x, y: by, r: R * swell, a: fade, born: a });
      if (swell < 1) { g.globalCompositeOperation = 'lighter'; var ma = (1 - smooth((a - .55) / .8)) * fade; glow(x, by, R * .9, S[2].halo, .5 * ma); glow(x, by, R * .22, [255, 255, 255], ma); g.strokeStyle = col(S[2].core, .35 * ma * (1 - fall)); g.lineWidth = Math.max(1, R * .05); g.lineCap = 'round'; g.beginPath(); g.moveTo(x, by - R * 1.3 * (1 - fall) - R * .2); g.lineTo(x, by); g.stroke(); g.globalCompositeOperation = 'source-over'; }
    }
    // their light on the water
    g.globalCompositeOperation = 'lighter';
    at.forEach(function (b, j) { if (!b || b.r < 1) return; g.save(); g.translate(b.x, hz + (hz - b.y) * .16); g.scale(1, .3); glow(0, 0, b.r * 3.4, SPOTS[j][2].halo, .22 * b.a); g.restore(); });
    g.globalCompositeOperation = 'source-over';
    for (k = 0; k < 2; k++) {
      var p = at[k], q = at[k + 1];
      if (!p || !q || q.born < 1.25) continue;
      var an = Math.atan2(q.y - p.y, q.x - p.x);
      thread([p.x + Math.cos(an) * p.r * .92, p.y + Math.sin(an) * p.r * .92], [q.x - Math.cos(an) * q.r * .92, q.y - Math.sin(an) * q.r * .92], (q.born - 1.25) / .7, t, fade, W);
    }
    at.forEach(function (b, j) { if (b) bubble(b.x, b.y, b.r, t, SPOTS[j][2], j * 3 + 1, b.a); });
  }

  function frame(now) {
    raf = 0;
    var dt = last ? Math.min(1, (now - last) / 1000) : 0; last = now;
    clock += dt;
    var c = clock % END;
    setPart(c < READ[0] || c > END - .35 ? -1 : c < READ[1] ? 0 : c < READ[2] ? 1 : c < READ[2] + 2.2 ? 2 : 3);
    sky(clock, c);
    if (seen && !document.hidden) raf = requestAnimationFrame(frame); else last = 0;
  }
  function wake() { if (!raf && seen && !document.hidden && !still) { last = 0; raf = requestAnimationFrame(frame); } }
  function rest() { duo.classList.add('live'); setPart(3); sky(4, HOLD - 1); }

  duo.classList.add('live');
  if (still) rest();
  else {
    setPart(3); sky(clock, clock % END);
    if ('IntersectionObserver' in window) new IntersectionObserver(function (es) { es.forEach(function (e) { seen = e.isIntersecting; wake(); }); }, { threshold: .12 }).observe(duo);
    else { seen = true; wake(); }
    document.addEventListener('visibilitychange', wake);
  }
  window.addEventListener('resize', function () { if (still || !raf) sky(still ? 4 : clock, still ? HOLD - 1 : clock % END); });
  if (mq) { var ch = function () { still = mq.matches; if (still) rest(); else wake(); }; if (mq.addEventListener) mq.addEventListener('change', ch); else if (mq.addListener) mq.addListener(ch); }

  // Which of the hero's ways on people take.
  duo.parentNode.addEventListener('click', function (e) { var a = e.target.closest('[data-hero]'); if (a) tfTrack('hero-to-' + a.getAttribute('data-hero')); });
})();

/* The rest of the page's small behaviours. */
(function () {
  var tfTrack = window.tfTrack || function () {};
  // "Watch the lesson" plays the video in place, the same as clicking its picture.
  var watch = document.getElementById('start-watch');
  if (watch) watch.addEventListener('click', function () {
    var player = document.querySelector('.start-player');
    if (player) { player.scrollIntoView({ behavior: 'smooth', block: 'center' }); player.click(); }
    else { var f = document.querySelector('.start-frame'); if (f) f.scrollIntoView({ behavior: 'smooth', block: 'center' }); }
  });
  var app = document.querySelector('.top-app');
  if (app) app.addEventListener('click', function () { tfTrack('top-to-app', 'Top bar: open the app'); });

  // A link to a part of the definition (#why-it-works, #what-sense …) opens that part.
  function openTarget() {
    var id = decodeURIComponent((location.hash || '').slice(1)), el = id && document.getElementById(id);
    var part = el && el.closest && el.closest('details.what-part');
    if (part && !part.open) { part.open = true; part.scrollIntoView({ block: 'start' }); }
  }
  window.addEventListener('hashchange', openTarget);
  openTarget();
  [].forEach.call(document.querySelectorAll('details.what-part'), function (d) {
    d.addEventListener('toggle', function () { if (d.open) tfTrack('what-open-' + ((d.querySelector('h3') || {}).id || 'part')); });
  });
})();
</script>

</body>
</html>
