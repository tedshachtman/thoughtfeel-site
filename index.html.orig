<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..600&family=Manrope:wght@400..800&display=swap">
<style>
  /* The home page, reworked 2026-11-10: one night theme (the lessons' own colours), a hero that shows the idea before
     any reading, and the long definition folded into parts that open. The page before this is in
     archive/2026-11-10 before the Fable redesign/. */
  :root {
    color-scheme: dark;
    --bg: #0c0a1d;
    --surface: #16122e;
    --surface-2: #1e193c;
    --rule: #2c2752;
    --rule-2: #3d3670;
    --ink: #f4f1ea;
    --ink-2: #bcb6d2;
    --ink-3: #918baf;
    --gold: #f3cb76;
    --gold-2: #e2a84a;
    --blue: #a9b9ff;
    --blue-soft: #232652;
    --night: #150d33;
    /* Names the test, the testimonials and the signup still use. */
    --indigo: var(--blue);
    --indigo-soft: var(--blue-soft);
    --weld: var(--gold);
    --term: var(--gold);
    --ok: #7fd1a3;
    --ok-soft: #173326;
    --miss: #f09a86;
    --miss-soft: #3a1f1a;
    --display: "Fraunces", Georgia, "Times New Roman", serif;
    --sans: "Manrope", "Helvetica Neue", Arial, sans-serif;
    --serif: var(--sans);
    --mono: var(--sans);
  }

  *, *::before, *::after { box-sizing: border-box; }
  [hidden] { display: none !important; }
  html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
  body {
    margin: 0; background: var(--bg); color: var(--ink);
    font-family: var(--sans); font-size: 17px; line-height: 1.6; -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }
  a { color: var(--blue); text-underline-offset: 3px; text-decoration-thickness: 1px; }
  a:hover { text-decoration-thickness: 2px; }
  :focus-visible { outline: 2px solid var(--gold); outline-offset: 3px; border-radius: 4px; }
  img { max-width: 100%; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }

  /* The night behind the top of the page: violet from the left, a little of the horizon's rose from the right. */
  .page { position: relative; }
  .page::before {
    content: ""; position: absolute; left: 0; right: 0; top: 0; height: 1100px; z-index: -1; pointer-events: none;
    background:
      radial-gradient(900px 560px at 12% -8%, rgba(116, 72, 214, .34), transparent 62%),
      radial-gradient(760px 520px at 96% 4%, rgba(210, 76, 120, .2), transparent 62%),
      radial-gradient(1100px 700px at 50% 46%, rgba(64, 52, 150, .2), transparent 66%);
  }
  .wrap { max-width: 1168px; margin: 0 auto; padding-inline: clamp(18px, 4vw, 32px); }
  .sec { padding-block: clamp(56px, 8vw, 104px); scroll-margin-top: 8px; }
  .eyebrow { font-weight: 700; font-size: 12.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--gold); margin: 0 0 12px; }
  h2 { font-family: var(--display); font-weight: 500; font-size: clamp(31px, 4.2vw, 46px); line-height: 1.08; letter-spacing: -0.018em; margin: 0; text-wrap: balance; }
  .sec-head { max-width: 46rem; }
  .sec-sub { margin: 14px 0 0; font-size: clamp(17px, 1.8vw, 19px); line-height: 1.55; color: var(--ink-2); max-width: 40rem; text-wrap: pretty; }

  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    font-family: var(--sans); font-weight: 700; font-size: 16px; line-height: 1.2;
    padding: 14px 22px; border-radius: 999px; border: 1.5px solid var(--rule-2);
    background: rgba(255, 255, 255, .03); color: var(--ink); text-decoration: none; cursor: pointer;
    transition: background .2s, border-color .2s, transform .2s;
  }
  .btn:hover { background: var(--surface-2); border-color: var(--blue); }
  .btn.primary { background: var(--gold); border-color: var(--gold); color: #1b1232; }
  .btn.primary:hover { background: #f8d98f; border-color: #f8d98f; transform: translateY(-1px); }
  .btn.small { padding: 10px 16px; font-size: 14.5px; }
  .btn .arrow { transition: transform .2s; }
  .btn:hover .arrow { transform: translateX(3px); }
  .row { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
  .linkish { background: none; border: 0; padding: 0; font: inherit; font-size: 15px; color: var(--ink-2); text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
  @media (prefers-reduced-motion: reduce) { .btn, .btn .arrow { transition: none; } }

  /* ---------- The top bar ---------- */
  .top { display: flex; align-items: center; gap: 20px; padding-block: 20px; }
  .mark { font-weight: 800; font-size: 23px; letter-spacing: -0.035em; color: var(--ink); text-decoration: none; }
  .mark span { color: var(--gold); }
  .top-links { display: none; gap: 26px; margin-left: auto; font-weight: 600; font-size: 15px; }
  .top-links a { color: var(--ink-2); text-decoration: none; }
  .top-links a:hover { color: var(--ink); }
  .top .btn { margin-left: auto; }
  @media (min-width: 860px) { .top-links { display: flex; } .top .btn { margin-left: 0; } }

  /* ---------- The hero: the promise, then the idea shown as two stories built the same way ---------- */
  .hero { padding-block: clamp(20px, 4vw, 44px) clamp(40px, 6vw, 72px); }
  .hero-top { display: grid; grid-template-columns: minmax(0, 1fr); gap: 18px; align-items: end; }
  @media (min-width: 960px) { .hero-top { grid-template-columns: minmax(0, 1fr) auto; gap: 22px 56px; } .hero-top h1 { grid-column: 1 / -1; } }
  h1 {
    font-family: var(--display); font-weight: 500; font-size: clamp(36px, 5.5vw, 68px); line-height: 1.03; letter-spacing: -0.025em;
    margin: 0; text-wrap: balance;
  }
  h1 em { font-style: italic; color: var(--gold); }
  .hero-sub { margin: 0; font-size: clamp(17px, 1.9vw, 20px); line-height: 1.5; color: var(--ink-2); max-width: 35rem; text-wrap: pretty; }
  .hero-sub b { color: var(--ink); font-weight: 700; }
  .hero-go { display: grid; gap: 14px; justify-items: start; }
  .hero-go .row { flex-wrap: nowrap; }
  @media (max-width: 520px) { .hero-go .row { flex-wrap: wrap; } .hero-go .btn { width: 100%; } }
  .hero-go-after { display: none; margin-top: 22px; }
  @media (max-width: 759px) {
    .hero-top .hero-go .btn:not(.primary), .hero-top .hero-go .proof { display: none; }
    .hero-go-after { display: grid; }
    .hero-sub { font-size: 16.5px; }
  }
  .proof { display: inline-flex; align-items: center; gap: 12px; font-size: 14.5px; line-height: 1.35; color: var(--ink-2); text-decoration: none; }
  .proof:hover { color: var(--ink); }
  .proof-faces { display: inline-flex; flex: none; }
  .proof-faces img { width: 30px; height: 30px; border-radius: 50%; object-fit: cover; border: 2px solid var(--bg); margin-left: -9px; background: var(--surface-2); }
  .proof-faces img:first-child { margin-left: 0; }

  .duo { display: grid; grid-template-columns: minmax(0, 1fr); gap: 26px; margin-top: clamp(28px, 4vw, 44px); }
  @media (min-width: 760px) { .duo { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; } }
  .duo-card { margin: 0; display: grid; grid-template-rows: auto auto auto; gap: 12px; align-content: start; }
  .duo-kind { display: flex; align-items: center; gap: 10px; margin: 0; font-weight: 800; font-size: 12.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-3); }
  .duo-kind::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: #ffe6b0; box-shadow: 0 0 12px rgba(255, 230, 176, .7); }
  .duo-feel .duo-kind::before { background: var(--blue); box-shadow: 0 0 12px rgba(169, 185, 255, .8); }
  /* The words being read. Each sentence lights as it's read, and its picture or its bubble arrives with it. */
  .duo-line { margin: 0; font-family: var(--display); font-style: italic; font-weight: 400; font-size: clamp(17.5px, 1.75vw, 21px); line-height: 1.4; color: var(--ink); text-wrap: pretty; }
  @media (min-width: 760px) { .duo-line { min-height: 2.8em; } }
  .duo-line span { transition: color .5s ease, opacity .5s ease; }
  .duo.live .duo-line span { color: var(--ink-3); opacity: .62; }
  .duo.live .duo-line span.is-said { color: var(--ink); opacity: 1; }
  .duo.live .duo-see .duo-line span.is-now { color: #ffe6b0; }
  .duo.live .duo-feel .duo-line span.is-said { color: var(--gold); }
  .duo.live .duo-feel .duo-line span.is-said:nth-child(2) { color: var(--blue); }
  .duo-frame {
    position: relative; aspect-ratio: 2 / 1; overflow: hidden; isolation: isolate; border-radius: 18px; background: #191430;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, .08), 0 30px 60px -34px rgba(0, 0, 0, .9);
  }
  .duo-see .duo-frame { box-shadow: 0 0 0 1px rgba(255, 230, 176, .22), 0 30px 60px -34px rgba(0, 0, 0, .9), 0 0 70px -30px rgba(255, 214, 140, .5); }
  .duo-feel .duo-frame { background: var(--night); box-shadow: 0 0 0 1px rgba(169, 185, 255, .22), 0 30px 60px -34px rgba(0, 0, 0, .9), 0 0 70px -30px rgba(140, 150, 255, .55); }
  .duo-shot { position: absolute; inset: 0; opacity: 0; transition: opacity .9s ease; }
  .duo-shot img { position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: cover; transform: scale(1.001); transition: transform 7s linear; }
  .duo-shot:last-of-type { opacity: 1; }
  .duo.live .duo-shot { opacity: 0; }
  .duo.live .duo-shot.is-on { opacity: 1; }
  .duo.live .duo-shot.is-on img { transform: scale(1.055); }
  /* Before the first sentence: nothing pictured yet. */
  .duo-empty { position: absolute; inset: 0; display: grid; place-items: center; background: radial-gradient(closest-side, #231c44, #171230); }
  .duo-empty i { width: 9px; height: 9px; border-radius: 50%; background: rgba(255, 230, 176, .5); animation: duo-wait 1.4s ease-in-out infinite; }
  @keyframes duo-wait { 50% { transform: scale(1.7); opacity: .35; } }
  .duo-sky { position: absolute; inset: 0; display: block; width: 100%; height: 100%; }
  .duo-card figcaption { font-size: 15.5px; line-height: 1.4; color: var(--ink-2); }
  .duo-card figcaption b { color: var(--ink); font-weight: 700; }
  .duo-same { margin: clamp(22px, 3vw, 34px) 0 0; text-align: center; font-family: var(--display); font-style: italic; font-size: clamp(19px, 2.3vw, 26px); line-height: 1.3; color: var(--gold); text-wrap: balance; }
  @media (prefers-reduced-motion: reduce) { .duo-shot, .duo-shot img, .duo-line span { transition: none !important; } .duo-empty i { animation: none; } }

  /* ---------- The test: the four ways on a stage, the question beside it ---------- */
  .test .sec-head { margin-bottom: clamp(22px, 3vw, 34px); }
  .imt-card { background: var(--surface); border: 1px solid var(--rule); border-radius: 22px; box-shadow: 0 40px 80px -50px rgba(0, 0, 0, .9); }
  .panel { display: flex; flex-direction: column; gap: 16px; }
  .imt .imt-panel { padding: 0 14px 18px; border-radius: 22px; }
  .fw-stage-wrap { position: sticky; top: 0; z-index: 3; margin: 0 -14px; padding-bottom: 6px; background: var(--surface); border-radius: 22px 22px 0 0; }
  .fw-stage-wrap::after { content: ""; position: absolute; left: 0; right: 0; top: 100%; height: 12px; background: linear-gradient(var(--surface), transparent); pointer-events: none; }
  .fw-stage { position: relative; aspect-ratio: 3 / 2; overflow: hidden; isolation: isolate; border-radius: 21px 21px 0 0; background: var(--night); -webkit-user-select: none; user-select: none; touch-action: pan-y; }
  @media (min-width: 900px) {
    .imt .imt-panel { display: grid; grid-template-columns: minmax(0, 1.12fr) minmax(0, 1fr); gap: 0 clamp(24px, 3vw, 40px); align-items: start; padding: 22px; }
    .fw-stage-wrap { grid-column: 1; grid-row: 1 / span 3; top: 22px; margin: 0; padding: 0; background: none; border-radius: 0; }
    .fw-stage-wrap::after { display: none; }
    .fw-stage { border-radius: 16px; }
    .imt .fw-rows, #imt-ask, #imt-result { grid-column: 2; }
    .imt .fw-rows { margin-top: 0; }
  }
  .fw-media { position: absolute; inset: 0; transition: transform 1.8s cubic-bezier(.2, .7, .2, 1); }
  .fw-media.push { transform: scale(1.04); }
  .fw-layer { position: absolute; inset: 0; opacity: 0; transition: opacity .7s ease; }
  .fw-layer.is-on { opacity: 1; }
  .fw.slow .fw-layer { transition-duration: 1.8s; }
  .fw-layer img, .fw-layer video { position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: cover; }
  .fw-layer video { opacity: 0; transition: opacity .3s linear; }
  .fw-layer.is-playing video { opacity: 1; }
  .fw-fx { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .fw-words {
    position: absolute; left: 0; right: 0; bottom: 13%; margin: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 0 .85em;
    font-weight: 700; font-size: clamp(14px, 3.4vw, 17px); letter-spacing: .01em; line-height: 1.4; color: #eef0ff; text-shadow: 0 1px 14px rgba(8, 4, 28, .85);
    z-index: 1; pointer-events: none;
  }
  .fw-words span { opacity: 0; transform: translateY(5px); transition: opacity .9s ease, transform .9s ease; }
  .fw-layer.is-on .fw-words span { opacity: .94; transform: none; transition-delay: .5s; }
  .fw-layer.is-on .fw-words span:nth-child(2) { transition-delay: 1.1s; }
  .fw-layer.is-on .fw-words span:nth-child(3) { transition-delay: 1.7s; }
  .fw.answered .fw-layer .fw-words span { opacity: 0; transition-delay: 0s; }
  .fw-dots { position: absolute; left: 50%; bottom: 8px; z-index: 2; display: flex; gap: 5px; transform: translateX(-50%); pointer-events: none; }
  .fw-dots i { width: 6px; height: 6px; border-radius: 3px; background: rgba(240, 236, 255, .5); box-shadow: 0 0 6px rgba(8, 4, 28, .6); transition: width .4s ease, background .4s ease; }
  .fw-dots i.is-on { width: 18px; background: var(--gold); }
  .fw-toggle {
    position: absolute; right: 10px; top: 10px; z-index: 2; width: 32px; height: 32px; padding: 0; border-radius: 50%; cursor: pointer;
    background: rgba(12, 8, 32, .52); border: 1px solid rgba(255, 255, 255, .22); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
  }
  .fw-toggle::before, .fw-toggle::after { content: ""; position: absolute; top: 10px; width: 3.5px; height: 11px; border-radius: 1px; background: #f6f2ff; }
  .fw-toggle::before { left: 10.5px; }
  .fw-toggle::after { left: 17px; }
  .fw-toggle[aria-pressed="true"]::before { left: 12px; top: 9.5px; width: 0; height: 0; border-radius: 0; background: none; border: solid transparent; border-width: 6.5px 0 6.5px 10px; border-left-color: #f6f2ff; }
  .fw-toggle[aria-pressed="true"]::after { display: none; }
  .fw-toggle:focus-visible { outline-offset: 2px; border-radius: 50%; }
  .imt .fw-rows { list-style: none; margin: 4px 0 2px; padding: 0; display: grid; gap: 6px; }
  .imt .fw-rows li { position: relative; border-radius: 12px; font-size: 16px; line-height: 1.45; color: var(--ink-2); transition: background .4s, box-shadow .4s, color .4s, opacity .7s ease, transform .7s ease; }
  .imt .fw-rows li::before { content: ""; position: absolute; left: 0; top: 12px; bottom: 12px; width: 3px; border-radius: 0 2px 2px 0; background: var(--rule-2); transition: background .4s; }
  .imt .fw-rows li.four::before { background: var(--blue); }
  .imt .fw-rows li:hover { background: rgba(255, 255, 255, .03); }
  .imt .fw-rows li.is-on { background: var(--surface-2); color: var(--ink); box-shadow: 0 0 0 1px var(--rule); }
  .imt .fw-rows li.is-on::before { background: var(--gold); }
  .fw-pick { display: block; width: 100%; margin: 0; padding: 12px 14px 15px 18px; border: 0; border-radius: 12px; background: none; cursor: pointer; font: inherit; line-height: inherit; color: inherit; text-align: left; }
  .imt .fw-pick b { font-weight: 800; color: var(--ink); }
  .fw-time { position: absolute; left: 18px; right: 14px; bottom: 6px; height: 2px; border-radius: 1px; background: var(--gold); transform: scaleX(0); transform-origin: left center; opacity: 0; pointer-events: none; }
  .fw-rows li.is-on .fw-time { opacity: .75; }
  .fw.js:not(.still) .fw-rows li { opacity: 0; transform: translateY(10px); }
  .fw.js.is-in .fw-rows li { opacity: 1; transform: none; }
  .fw.js.is-in .fw-rows li:nth-child(2) { transition-delay: 0s, 0s, 0s, .12s, .12s; }
  .fw.js.is-in .fw-rows li:nth-child(3) { transition-delay: 0s, 0s, 0s, .24s, .24s; }
  .fw.js.is-in .fw-rows li:nth-child(4) { transition-delay: 0s, 0s, 0s, .36s, .36s; }
  @media (prefers-reduced-motion: reduce) {
    .fw-media, .fw-layer, .fw-layer video, .fw-words span, .fw-rows li { transition: none !important; }
    .fw-media.push { transform: none; }
  }
  #imt-ask, #imt-result { padding: 6px 4px 2px; }
  #imt-result { display: grid; gap: 12px; }
  .imt .imt-q { font-family: var(--display); font-weight: 500; font-size: clamp(23px, 2.5vw, 28px); line-height: 1.2; letter-spacing: -0.01em; margin: 6px 0 14px; }
  .imt .imt-choices { display: flex; flex-wrap: wrap; gap: 10px; }
  .imt .imt-choice { background: var(--surface-2); border-color: var(--rule-2); }
  .imt .imt-choice:hover { border-color: var(--gold); background: var(--surface-2); }
  .imt .imt-label { font-weight: 700; font-size: 12.5px; letter-spacing: .12em; text-transform: uppercase; color: var(--gold); margin: 0; }
  .imt .imt-head { font-family: var(--display); font-weight: 500; font-size: clamp(25px, 2.8vw, 32px); line-height: 1.15; letter-spacing: -0.012em; margin: 0; text-wrap: balance; outline: none; }
  .imt .imt-text { margin: 0; color: var(--ink-2); }
  .imt .imt-actions { display: flex; flex-wrap: wrap; gap: 10px; }

  /* ---------- Start here: the lesson ---------- */
  .start-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 26px clamp(28px, 4vw, 56px); align-items: center; }
  @media (min-width: 900px) { .start-grid { grid-template-columns: minmax(0, 1.22fr) minmax(0, 1fr); } }
  .start-player {
    position: relative; display: block; aspect-ratio: 16 / 9; overflow: hidden; border-radius: 20px; background: var(--night);
    box-shadow: 0 0 0 1px rgba(255, 255, 255, .1), 0 40px 80px -44px rgba(0, 0, 0, .95), 0 0 90px -40px rgba(140, 110, 255, .6);
  }
  .start-player img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .6s ease; }
  .start-player:hover img { transform: scale(1.02); }
  .start-frame { display: block; width: 100%; aspect-ratio: 16 / 9; border: 0; border-radius: 20px; background: #000; }
  .play { position: absolute; left: 50%; top: 50%; width: 68px; height: 68px; margin: -34px 0 0 -34px; border-radius: 50%; background: var(--ink); box-shadow: 0 8px 26px rgba(8, 4, 28, .5); transition: transform .2s ease; }
  .play::after { content: ""; position: absolute; left: 27px; top: 21px; border-style: solid; border-width: 13px 0 13px 20px; border-color: transparent transparent transparent #2b2370; }
  /* The play button sits on the learner's sweater, clear of the thumbnail's title. */
  .start-player .play { left: 71%; top: 70%; }
  .start-player:hover .play, .start-player:focus-visible .play, .video:hover .play { transform: scale(1.08); }
  @media (max-width: 600px) { .start-player .play { width: 50px; height: 50px; margin: -25px 0 0 -25px; } .start-player .play::after { left: 20px; top: 15px; border-width: 10px 0 10px 15px; } }
  .start-steps { list-style: none; margin: 20px 0 0; padding: 0; display: grid; gap: 10px; counter-reset: s; }
  .start-steps li { counter-increment: s; display: grid; grid-template-columns: 30px minmax(0, 1fr); gap: 12px; align-items: start; font-size: 16.5px; line-height: 1.45; color: var(--ink-2); }
  .start-steps li::before { content: counter(s); display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; background: var(--blue-soft); color: var(--blue); font-weight: 800; font-size: 14px; }
  .start-steps b { color: var(--ink); font-weight: 700; }
  .start .row { margin-top: 24px; }
  .start-meta { margin: 16px 0 0; font-size: 15px; line-height: 1.5; color: var(--ink-3); }

  /* ---------- More to watch ---------- */
  .videos { margin-top: clamp(40px, 6vw, 72px); }
  .videos h3 { font-weight: 800; font-size: 12.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-3); margin: 0 0 16px; }
  .video-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px; }
  @media (min-width: 720px) { .video-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; } }
  .video { display: grid; grid-template-columns: minmax(0, 150px) minmax(0, 1fr); gap: 16px; align-items: center; padding: 12px; border-radius: 18px; background: var(--surface); border: 1px solid var(--rule); color: var(--ink); text-decoration: none; transition: border-color .2s, background .2s; }
  .video:hover { border-color: var(--rule-2); background: var(--surface-2); }
  @media (min-width: 1000px) { .video { grid-template-columns: minmax(0, 200px) minmax(0, 1fr); gap: 20px; } }
  .thumb { position: relative; display: block; aspect-ratio: 16 / 9; overflow: hidden; border-radius: 11px; background: var(--night); }
  .thumb img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .thumb .play { width: 38px; height: 38px; margin: -19px 0 0 -19px; }
  .thumb .play::after { left: 15px; top: 11px; border-width: 8px 0 8px 12px; }
  .video-body { display: grid; gap: 3px; }
  .video-label { font-weight: 700; font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: var(--gold); }
  .video-title { font-weight: 700; font-size: 16.5px; line-height: 1.3; text-wrap: balance; }
  .video-desc { font-size: 14.5px; line-height: 1.45; color: var(--ink-2); }
  @media (max-width: 520px) { .video-desc { display: none; } }

  /* ---------- Testimonials ---------- */
  .voices { position: relative; }
  .voices-head { padding-right: 104px; }
  .voices-track { display: flex; gap: 16px; align-items: flex-start; margin-top: 28px; padding: 2px 2px 16px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: 2px; overscroll-behavior-x: contain; scrollbar-width: thin; scrollbar-color: var(--rule-2) transparent; }
  .voices-track:focus-visible { outline: 2px solid var(--blue); outline-offset: 4px; border-radius: 18px; }
  .voice { flex: 0 0 86%; scroll-snap-align: start; margin: 0; display: flex; flex-direction: column; gap: 16px; background: var(--surface); border: 1px solid var(--rule); border-radius: 20px; padding: 22px 22px 18px; transition: flex-basis .25s ease; }
  @media (min-width: 720px) { .voice { flex-basis: calc((100% - 16px) / 2); } }
  @media (min-width: 1080px) { .voice { flex-basis: calc((100% - 32px) / 3); } }
  .voice:has(.voice-more[open]) { flex-basis: min(100%, 640px); }
  .voice-who { order: 2; display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 12px; align-items: center; margin: 0; }
  .voice-photo { width: 48px; height: 48px; border-radius: 50%; object-fit: cover; background: var(--surface-2); }
  .voice-initial { display: grid; place-items: center; font-weight: 800; font-size: 20px; line-height: 1; color: var(--blue); }
  .voice-meta { display: grid; gap: 1px; }
  .voice-name { font-weight: 800; font-size: 16px; line-height: 1.25; }
  .voice-role { font-size: 14px; line-height: 1.4; color: var(--ink-2); }
  .voice-link { font-size: 13.5px; line-height: 1.4; margin-top: 2px; justify-self: start; }
  .voice-pull { order: 1; margin: 0; font-family: var(--display); font-weight: 400; font-size: clamp(19px, 1.9vw, 21.5px); line-height: 1.38; letter-spacing: -0.005em; text-wrap: pretty; }
  .voice-more { order: 3; margin-top: auto; }
  .voice-more summary { list-style: none; cursor: pointer; display: inline-flex; align-items: center; gap: 10px; padding: 4px 0; font-weight: 700; font-size: 14.5px; color: var(--blue); }
  .voice-more summary::-webkit-details-marker { display: none; }
  .voice-more summary:focus-visible { outline: 2px solid var(--blue); outline-offset: 3px; border-radius: 6px; }
  .voice-plus { position: relative; flex: none; width: 24px; height: 24px; border-radius: 50%; border: 1.5px solid var(--blue); }
  .voice-plus::before, .voice-plus::after { content: ""; position: absolute; left: 50%; top: 50%; width: 10px; height: 1.5px; background: var(--blue); transform: translate(-50%, -50%); transition: transform .2s ease; }
  .voice-plus::after { transform: translate(-50%, -50%) rotate(90deg); }
  .voice-more[open] .voice-plus::after { transform: translate(-50%, -50%) rotate(0deg); }
  .voice-open, .voice-more[open] .voice-closed { display: none; }
  .voice-more[open] .voice-open { display: inline; }
  .voice-text { margin: 12px 0 0; padding: 0; border: 0; background: none; font-size: 16px; line-height: 1.6; color: var(--ink-2); }
  .voice-text p { margin: 0 0 12px; }
  .voice-text p:last-child { margin-bottom: 0; }
  .voices-nav { position: absolute; right: 0; top: 10px; display: flex; gap: 8px; }
  .voices-nav[hidden] { display: none; }
  .voices-arrow { width: 42px; height: 42px; border-radius: 50%; border: 1.5px solid var(--rule-2); background: var(--surface); color: var(--ink); font-size: 22px; line-height: 1; cursor: pointer; }
  .voices-arrow:disabled { opacity: .35; cursor: default; }
  .voices-arrow:not(:disabled):hover { border-color: var(--blue); }

  /* ---------- What is thoughtfeel? The definition, then parts that open ---------- */
  .what-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 28px clamp(32px, 5vw, 72px); align-items: start; }
  @media (min-width: 960px) { .what-grid { grid-template-columns: minmax(0, .9fr) minmax(0, 1.25fr); } .what-head { position: sticky; top: 32px; } }
  .what-lead { margin: 18px 0 0; font-family: var(--display); font-weight: 400; font-size: clamp(21px, 2.4vw, 27px); line-height: 1.36; letter-spacing: -0.008em; color: var(--ink); text-wrap: pretty; }
  .what-more { margin: 18px 0 0; font-size: 15px; color: var(--ink-3); }
  .what-parts { display: grid; gap: 10px; }
  .what-part { background: var(--surface); border: 1px solid var(--rule); border-radius: 18px; transition: border-color .2s, background .2s; scroll-margin-top: 16px; }
  .what-part[open] { border-color: var(--rule-2); background: var(--surface-2); }
  .what-part summary { list-style: none; cursor: pointer; display: grid; grid-template-columns: 44px minmax(0, 1fr) 28px; grid-template-areas: "i t p" "i g p"; gap: 3px 16px; align-items: center; padding: 16px 18px; border-radius: 18px; }
  .what-part summary .what-icon { grid-area: i; } .what-part summary h3 { grid-area: t; align-self: end; } .what-part summary .what-gist { grid-area: g; align-self: start; } .what-part summary .what-plus { grid-area: p; }
  .what-part[open] summary h3 { grid-row: 1 / span 2; align-self: center; }
  .what-part summary::-webkit-details-marker { display: none; }
  .what-part summary:hover h3 { color: var(--gold); }
  .what-icon { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 13px; background: var(--blue-soft); color: var(--blue); }
  .what-icon svg { width: 23px; height: 23px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .what-sum { display: grid; gap: 3px; }
  .what-part h3 { font-weight: 800; font-size: clamp(17px, 1.8vw, 19px); line-height: 1.3; letter-spacing: -0.01em; margin: 0; text-wrap: balance; transition: color .2s; scroll-margin-top: 90px; }
  .what-gist { font-size: 15px; line-height: 1.45; color: var(--ink-2); }
  .what-part[open] .what-gist { display: none; }
  .what-plus { position: relative; justify-self: end; width: 28px; height: 28px; border-radius: 50%; border: 1.5px solid var(--rule-2); }
  .what-plus::before, .what-plus::after { content: ""; position: absolute; left: 50%; top: 50%; width: 11px; height: 1.5px; background: var(--ink-2); transform: translate(-50%, -50%); transition: transform .2s ease; }
  .what-plus::after { transform: translate(-50%, -50%) rotate(90deg); }
  .what-part[open] .what-plus::after { transform: translate(-50%, -50%) rotate(0deg); }
  .what-part-body { padding: 0 20px 20px 78px; }
  .what-part-body p { margin: 0 0 12px; font-size: 16.5px; line-height: 1.62; color: var(--ink-2); max-width: 36rem; }
  .what-part-body p:last-child { margin-bottom: 0; }
  .what-part-body p.what-cite { font-size: 14px; line-height: 1.45; color: var(--ink-3); }
  .what-figure { margin: 18px 0 0; }
  .what-figure img { display: block; width: 100%; max-width: 520px; height: auto; border-radius: 14px; box-shadow: 0 0 0 1px var(--rule); }
  .what-figure figcaption { margin-top: 10px; font-size: 14px; line-height: 1.4; color: var(--ink-3); }
  @media (max-width: 600px) {
    .what-part summary { grid-template-columns: 38px minmax(0, 1fr) 26px; gap: 3px 12px; padding: 14px; }
    .what-icon { width: 38px; height: 38px; border-radius: 11px; }
    .what-icon svg { width: 20px; height: 20px; }
    .what-part-body { padding: 0 16px 18px; }
  }

  /* ---------- Email ---------- */
  .updates { display: grid; grid-template-columns: minmax(0, 1fr); gap: 20px 48px; align-items: start; background: linear-gradient(140deg, #1c1740, #14102b 70%); border: 1px solid var(--rule); border-radius: 24px; padding: clamp(22px, 4vw, 40px); scroll-margin-top: 16px; }
  @media (min-width: 900px) { .updates { grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); } }
  .updates h2 { font-size: clamp(27px, 3.2vw, 36px); }
  .updates-text p:not(.eyebrow) { margin: 12px 0 0; color: var(--ink-2); font-size: 16.5px; max-width: 30rem; }
  .signup { display: grid; gap: 12px; }
  .signup-row { display: flex; flex-wrap: wrap; gap: 10px; }
  .signup-row input { flex: 1 1 220px; }
  .signup input[type="email"] { font: 600 16.5px/1.2 var(--sans); color: var(--ink); background: var(--bg); border: 1.5px solid var(--rule-2); border-radius: 999px; padding: 14px 20px; min-width: 0; }
  .signup input[type="email"]::placeholder { color: var(--ink-3); }
  .signup input[type="email"]:focus { border-color: var(--blue); outline: none; box-shadow: 0 0 0 3px var(--blue-soft); }
  .signup-q { border: 0; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 18px; font-size: 15px; }
  .signup-q legend { width: 100%; padding: 0; margin-bottom: 4px; color: var(--ink); }
  .signup-q legend span { color: var(--ink-3); }
  .signup-q label { display: inline-flex; align-items: center; gap: 6px; cursor: pointer; color: var(--ink-2); }
  .signup-q input, .signup-wait input { accent-color: var(--gold); }
  .signup-wait { display: flex; align-items: flex-start; gap: 8px; font-size: 15px; line-height: 1.4; cursor: pointer; color: var(--ink-2); }
  .signup-wait input { margin: 3px 0 0; flex: none; }
  .signup-trap { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .signup-status { margin: 0; font-size: 15px; min-height: 1.2em; }
  .signup-status.ok, .ok { color: var(--ok); }
  .signup-status.miss, .miss { color: var(--miss); }
  .signup-note { margin: 0; font-size: 13.5px; color: var(--ink-3); }

  /* ---------- About ---------- */
  .about { display: grid; grid-template-columns: minmax(0, 1fr); gap: 28px clamp(32px, 5vw, 72px); align-items: start; scroll-margin-top: 16px; }
  @media (min-width: 900px) { .about { grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); } }
  .about-hello { display: flex; align-items: center; gap: 20px; margin: 0 0 18px; }
  .about-photo { display: block; flex: none; width: 96px; height: 96px; border-radius: 50%; object-fit: cover; box-shadow: 0 0 0 3px var(--bg), 0 0 0 4.5px var(--rule-2); }
  @media (min-width: 900px) { .about-photo { width: 120px; height: 120px; } }
  .about h2 { font-size: clamp(28px, 3.4vw, 38px); }
  .about-text p:not(.eyebrow) { margin: 0 0 12px; color: var(--ink-2); max-width: 38rem; }
  .contact { background: var(--surface); border: 1px solid var(--rule); border-radius: 20px; padding: 24px; }
  .contact h3 { font-family: var(--display); font-weight: 500; font-size: 25px; letter-spacing: -0.01em; margin: 0 0 8px; }
  .contact p { margin: 0 0 14px; color: var(--ink-2); }
  .contact strong { color: var(--gold); font-weight: 700; }
  .email { font-weight: 600; font-size: 16px; background: var(--bg); border: 1px solid var(--rule); border-radius: 12px; padding: 11px 14px; user-select: all; word-break: break-all; color: var(--ink) !important; }

  /* ---------- Footer ---------- */
  .join { margin-top: 0; padding-block: 40px 56px; border-top: 1px solid var(--rule); display: grid; grid-template-columns: minmax(0, 1fr); gap: 28px 56px; }
  @media (min-width: 820px) { .join { grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); } }
  .join h2 { font-size: clamp(25px, 3vw, 31px); margin: 0 0 10px; }
  .join p { margin: 0 0 16px; color: var(--ink-2); max-width: 30rem; }
  .join ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 14px 28px; }
  @media (min-width: 520px) { .join ul { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .join li a { font-weight: 700; font-size: 15.5px; }
  .join li span { display: block; font-size: 14px; line-height: 1.4; color: var(--ink-3); }
  .colophon { grid-column: 1 / -1; margin: 12px 0 0 !important; font-size: 13px; color: var(--ink-3) !important; }

  /* Sections come in as they scroll onto the screen. It's tied to the scroll position in CSS, with no script, so a
     browser that can't do it (or a visitor who prefers no motion) simply sees the page. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .rv { animation: rv-in linear both; animation-timeline: view(); animation-range: entry 0% entry 36%; }
      @keyframes rv-in { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: none; } }
    }
  }
</style>

<div class="page">

  <div class="wrap">
    <nav class="top" aria-label="Site">
      <a class="mark" href="/" aria-label="Concept bubbles, home">concept <span>bubbles</span></a>
      <div class="top-links">
        <a href="#test">The test</a>
        <a href="#start">The lesson</a>
        <a href="#testimonials">What people say</a>
        <a href="#what">What it is</a>
        <a href="#about">About</a>
      </div>
      <a class="btn small top-app" href="https://stories.thoughtfeel.net/#/lesson" target="_blank" rel="noopener">Open the app</a>
    </nav>

    <!-- ================= The idea, shown before any reading ================= -->
    <header class="hero">
      <div class="hero-top">
        <h1>Follow an idea the way you <em>picture a story</em>.</h1>
        <p class="hero-sub"><b>Concept bubbles</b> is a learning technique for complex material. It uses unsymbolized thinking, the psychologist Russell Hurlburt’s name for a thought with no words and no pictures.</p>
        <div class="hero-go">
          <div class="row">
            <a class="btn primary" href="#test" data-hero="test">Can you do it? One question <span class="arrow" aria-hidden="true">→</span></a>
            <a class="btn" href="#start" data-hero="lesson">Take the lesson</a>
          </div>
          <a class="proof" href="#testimonials" data-hero="proof">
            <span class="proof-faces" aria-hidden="true">
              <img src="/img/rohan-reddy.jpg" width="60" height="60" alt="">
              <img src="/img/zed-barakat.jpg" width="60" height="60" alt="">
              <img src="/img/julian-putnam.jpg" width="60" height="60" alt="">
              <img src="/img/liam-daly-smith.jpg" width="60" height="60" alt="">
              <img src="/img/max-gurkalov.jpg" width="60" height="60" alt="">
            </span>
            <span>Used by medical students, engineers<br>and language learners</span>
          </a>
        </div>
      </div>

      <div class="duo" id="duo">
        <figure class="duo-card duo-see">
          <p class="duo-kind">A story you can see</p>
          <p class="duo-line"><span>A boy and a girl went to the well.</span> <span>The boy pumped water.</span> <span>The girl poured it on the grass.</span></p>
          <div class="duo-frame" role="img" aria-label="The story as three pictures: a boy and a girl walk to a well, the boy pumps water, and the girl pours it on a patch of grass.">
            <span class="duo-empty" aria-hidden="true"><i></i></span>
            <picture class="duo-shot"><source srcset="/img/hero/well-1.webp" type="image/webp"><img src="/img/hero/well-1.jpg" width="1280" height="640" alt="" fetchpriority="high"></picture>
            <picture class="duo-shot"><source srcset="/img/hero/well-2.webp" type="image/webp"><img src="/img/hero/well-2.jpg" width="1280" height="640" alt=""></picture>
            <picture class="duo-shot"><source srcset="/img/hero/well-3.webp" type="image/webp"><img src="/img/hero/well-3.jpg" width="1280" height="640" alt=""></picture>
          </div>
          <figcaption><b>Your mind’s eye</b> turns each line into a picture.</figcaption>
        </figure>
        <figure class="duo-card duo-feel">
          <p class="duo-kind">A story you can’t see</p>
          <p class="duo-line"><span>In 2008, Chinese authors</span> <span>wrote about America’s economic crisis,</span> <span>and how fast China was growing by comparison.</span></p>
          <div class="duo-frame" role="img" aria-label="The story as three concept bubbles: three soft lights in a night sky, one for each part of the sentence, joined by threads of light.">
            <canvas class="duo-sky" aria-hidden="true"></canvas>
          </div>
          <figcaption><b>Unsymbolized thinking</b> turns each line into a concept bubble.</figcaption>
        </figure>
      </div>
      <p class="duo-same">Same steps. Same payoff: you understand it, and you remember it.</p>
      <!-- On phones the lesson button and the line about who uses it come after the picture. -->
      <div class="hero-go hero-go-after">
        <a class="btn" href="#start" data-hero="lesson">Take the lesson</a>
        <a class="proof" href="#testimonials" data-hero="proof">
          <span class="proof-faces" aria-hidden="true">
            <img src="/img/rohan-reddy.jpg" width="60" height="60" alt="" loading="lazy">
            <img src="/img/zed-barakat.jpg" width="60" height="60" alt="" loading="lazy">
            <img src="/img/julian-putnam.jpg" width="60" height="60" alt="" loading="lazy">
            <img src="/img/liam-daly-smith.jpg" width="60" height="60" alt="" loading="lazy">
            <img src="/img/max-gurkalov.jpg" width="60" height="60" alt="" loading="lazy">
          </span>
          <span>Used by medical students, engineers and language learners</span>
        </a>
      </div>
    </header>
  </div>

  <!-- ================= The one-question test ================= -->
  <section class="sec test" id="test" aria-labelledby="test-title">
    <div class="wrap">
      <div class="sec-head rv">
        <p class="eyebrow">One question</p>
        <h2 id="test-title">Can you do it?</h2>
        <p class="sec-sub imt-intro">Think about your best friend. There are four ways people do it. Read all four, then answer one question.</p>
      </div>
      <div class="imt-card imt rv">
        <div class="panel imt-panel fw" id="imt" aria-live="polite">
          <div class="fw-stage-wrap" aria-live="off">
            <div class="fw-stage">
              <div class="fw-media" role="img" aria-label="Someone with their eyes closed pictures their best friend: a sunlit picture of the friend, smiling in a park, hangs in the air above them.">
                <div class="fw-layer is-on" data-video="/img/quiz/way-1.mp4" data-alt="Someone with their eyes closed pictures their best friend: a sunlit picture of the friend, smiling in a park, hangs in the air above them.">
                  <img src="/img/quiz/way-1.jpg" width="960" height="640" alt="" loading="lazy" decoding="async">
                </div>
                <div class="fw-layer" data-video="/img/quiz/way-2.mp4" data-alt="Someone with their eyes closed hears their best friend’s voice: a warm ribbon of sound circles their head, swelling as the friend speaks.">
                  <img data-src="/img/quiz/way-2.jpg" width="960" height="640" alt="" decoding="async">
                </div>
                <div class="fw-layer" data-video="/img/quiz/way-3.mp4" data-alt="Someone looks down at the red mug on their desk and pays attention to its color, smiling. There’s no picture of their friend.">
                  <img data-src="/img/quiz/way-3.jpg" width="960" height="640" alt="" decoding="async">
                </div>
                <div class="fw-layer" data-video="/img/quiz/way-4.mp4" data-alt="The friend as a concept bubble: a soft glow of light in a night sky over a still lake, the friend’s warmth turning inside it, with no outline and no edge.">
                  <img data-src="/img/quiz/way-4.jpg" width="960" height="640" alt="" decoding="async">
                  <p class="fw-words" aria-hidden="true"><span>No shape.</span> <span>No size.</span> <span>No color.</span></p>
                </div>
                <canvas class="fw-fx" aria-hidden="true"></canvas>
              </div>
              <span class="fw-dots" aria-hidden="true"><i class="is-on"></i><i></i><i></i><i></i></span>
              <button class="fw-toggle" type="button" aria-label="Pause the animation" aria-pressed="false" hidden></button>
            </div>
          </div>
          <ol class="imt-ways fw-rows">
            <li class="is-on"><button class="fw-pick" type="button" aria-current="step"><b>1 · A picture of your friend.</b> It has shape, size and color, and it feels like looking at something.</button><span class="fw-time" aria-hidden="true"></span></li>
            <li><button class="fw-pick" type="button"><b>2 · Your friend’s voice.</b> You hear their voice in your head.</button><span class="fw-time" aria-hidden="true"></span></li>
            <li><button class="fw-pick" type="button"><b>3 · Just knowing.</b> You just know you’re thinking about your friend. To feel this one, stare at something near you and pay attention to its color. You still know you’re thinking about your best friend.</button><span class="fw-time" aria-hidden="true"></span></li>
            <li class="four"><button class="fw-pick" type="button"><b>4 · A concept bubble of your friend.</b> It feels like looking at something, but it has no shape, size or color, and it’s obviously your best friend.</button><span class="fw-time" aria-hidden="true"></span></li>
          </ol>
          <div id="imt-ask">
            <p class="imt-q">Can you do the fourth one?</p>
            <div class="imt-choices">
              <button type="button" class="btn imt-choice" data-answer="yes">Yes</button>
              <button type="button" class="btn imt-choice" data-answer="kindof">I kind of get what you mean</button>
              <button type="button" class="btn imt-choice" data-answer="no">What are you talking about?</button>
            </div>
            <noscript><p class="imt-text">If you can get a sense of what the fourth one is asking you to do, you can use concept bubbles. If it sounds like nothing, you probably can’t.</p></noscript>
          </div>
          <div id="imt-result" hidden></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= Start here: the lesson ================= -->
  <section class="sec start" id="start" aria-labelledby="start-title">
    <div class="wrap">
      <div class="start-grid">
        <a class="start-player rv" href="https://www.youtube.com/watch?v=tgLRhlMjVkI" target="_blank" rel="noopener" aria-label="Play the video: Learn a Bloom filter in your head: the interactive concept bubbles lesson">
          <img src="https://i.ytimg.com/vi/tgLRhlMjVkI/maxresdefault.jpg" alt="" width="1280" height="720" loading="lazy" onerror="this.onerror=null;this.src='https://i.ytimg.com/vi/tgLRhlMjVkI/hqdefault.jpg'">
          <span class="play" aria-hidden="true"></span>
        </a>
        <div class="start-text rv">
          <p class="eyebrow">Start here · 14 minutes</p>
          <h2 id="start-title">Learn a Bloom filter in your head</h2>
          <ol class="start-steps">
            <li><span><b>Find out if you can think without words or pictures</b>, and learn what a concept bubble is.</span></li>
            <li><span><b>Build a complicated idea</b>, how a Bloom filter works, as a concept story, one line at a time.</span></li>
            <li><span><b>Explain it back from memory</b>, then compare it with a visual analogy.</span></li>
          </ol>
          <div class="row">
            <button class="btn primary" type="button" id="start-watch">Watch the lesson</button>
            <a class="btn start-app" href="https://stories.thoughtfeel.net/#/lesson" target="_blank" rel="noopener">Do it in the app <span class="arrow" aria-hidden="true">→</span></a>
          </div>
          <p class="start-meta">The app, stories.thoughtfeel.net, plays the story one line at a time.</p>
        </div>
      </div>

      <div class="videos rv" id="videos">
        <h3>More to watch</h3>
        <div class="video-grid">
          <a class="video" href="https://www.youtube.com/watch?v=I3WgK8cPa0A" target="_blank" rel="noopener">
