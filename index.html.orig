window.tfTrack = function (path, title) {
  try {
    var send = function () { window.goatcounter.count({ path: path, title: title || path, event: true }); };
    if (window.goatcounter && window.goatcounter.count) send(); else (window.tfQueue = window.tfQueue || []).push(send);
  } catch (e) {}
};
</script>
<script data-goatcounter="https://thoughtfeel.goatcounter.com/count" async src="//gc.zgo.at/count.js"
  onload="(window.tfQueue || []).forEach(function (f) { try { f(); } catch (e) {} }); window.tfQueue = [];"></script>
<script>
(function () {
  var KIT = {"lessons":"","waitlist":""};
  // Keep the visit's first ?ref, so a signup on a later page still says where the visitor came from.
  var ref = '';
  try {
    ref = new URLSearchParams(location.search).get('ref') || sessionStorage.getItem('tf.ref') || '';
    if (ref && !sessionStorage.getItem('tf.ref')) sessionStorage.setItem('tf.ref', ref);
  } catch (e) {}
  window.tfSignup = function (d) {
    var list = d.list === 'waitlist' ? 'waitlist' : 'lessons', fields = {};
    Object.keys(d.fields || {}).forEach(function (k) { if (d.fields[k] !== '' && d.fields[k] != null) fields[k] = String(d.fields[k]); });
    fields.waitlist = list === 'waitlist' ? 'yes' : 'no';
    fields.signup_page = location.pathname;
    if (ref) fields.ref = ref;
    if (KIT[list]) {
      var body = new URLSearchParams();
      body.append('email_address', d.email);
      Object.keys(fields).forEach(function (k) { body.append('fields[' + k + ']', fields[k]); });
      return fetch('https://app.kit.com/forms/' + KIT[list] + '/subscriptions', { method: 'POST', headers: { 'Accept': 'application/json' }, body: body })
        .then(function (r) { return r.json(); })
        .then(function (j) { if (!j || j.status !== 'success') throw new Error('not accepted'); return j; });
    }
    var payload = { email: d.email, list: list, _subject: d.subject || 'New thoughtfeel signup', _template: 'table' };
    Object.keys(fields).forEach(function (k) { payload[k] = fields[k]; });
    return fetch('https://formsubmit.co/ajax/teddyshachtman@gmail.com', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify(payload)
    })
      .then(function (r) { return r.json(); })
      .then(function (j) { if (String(j && j.success) !== 'true') throw new Error('not accepted'); return j; });
  };
})();
</script>
</head>
<body>
<title>Concept bubbles: a learning technique</title>
<!-- Who and what this site is, for search engines and AI assistants (2026-10-25). The definition page has the rest. -->
